# 从接入控制台复制。shyfai.cn 是文档站，不是 API 地址。
# 若控制台地址以 /v1 结尾，可以原样填写，客户端会去掉末尾 /v1。
SHYFAI_BASE_URL=https://api.example.com
SHYFAI_API_KEY=sk-your-key

# 公开上传入口。留空时默认与 SHYFAI_BASE_URL 相同。
# 聚合平台若没有 /v1/images/uploads，图生图会自动改为直接上传文件。
SHYFAI_UPLOAD_BASE_URL=

# 默认模型。以 GET /v1/models 返回的 id 为准。
SHYFAI_MODEL=gpt-image-2
